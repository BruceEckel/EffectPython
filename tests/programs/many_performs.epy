# Milestone 3 stress: ten thousand performs inside one handle block.
# The clause ends with eff.resume(...), so dispatch switches into the
# body from its loop instead of nesting a clause evaluation per perform
# (plan 3.4, step 4). Before that, the nesting overflowed RPython's
# stack guard between 1600 and 1800 performs.

from effectpython import Effect, perform, handle

class Counter(Effect):
    def tick(n: int) -> int: ...

def main() -> int / []:
    try:
        with handle(Counter):
            i = 0
            total = 0
            while i < 10000:
                total = total + perform(Counter.tick(i))
                i = i + 1
            print(total)
    except Counter.tick as eff:
        eff.resume(eff.n % 10)
    return 0
