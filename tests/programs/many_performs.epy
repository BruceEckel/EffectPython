# Milestone 3 stress: a thousand performs inside one handle block.
# Each clause runs nested inside the previous clause's eff.resume()
# (plan 3.4, step 4), so this nests a thousand clause evaluations on
# the handler side's C stack. Ten thousand aborts the binary with
# "Fatal RPython error: StackOverflow"; the limit is between 1600 and
# 1800 (plan 4.2, Milestone 3).

from effectpython import Effect, perform, handle

class Counter(Effect):
    def tick(n: int) -> int: ...

def main() -> int / []:
    try:
        with handle(Counter):
            i = 0
            total = 0
            while i < 1000:
                total = total + perform(Counter.tick(i))
                i = i + 1
            print(total)
    except Counter.tick as eff:
        eff.resume(eff.n % 10)
    return 0
