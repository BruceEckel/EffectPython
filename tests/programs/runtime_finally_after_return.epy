# Runtime-only: the finally runs after the clause returned with x a
# str, where the suite's end would have left it an int. The checker
# checks the finally from every path into it, so x is unknown there
# and the operator passes; the runtime finds the str.

class Boom(Exception):
    pass

def f() -> int:
    x = 1
    try:
        raise Boom("b")
    except Boom:
        x = "s"
        return 0
    finally:
        print(x + 1)
    return 1

def main() -> int:
    return f()
