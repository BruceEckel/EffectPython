# The clause deletes e while the body is suspended, and the body reads
# e after it resumes, earlier in the source than the deletion. The pass
# that unbinds a name is followed by another over the body, which
# finds the read unbound.

from effectpython import Effect, perform, handle

class Boom(Exception):
    pass

class Ask(Effect):
    def get() -> int: ...

def main() -> int:
    if 1 == 1:
        e = "s"
    else:
        e = 1
    try:
        with handle(Ask):
            perform(Ask.get())
            print(e)
    except Ask.get as eff:
        try:
            raise Boom("b")
        except Boom as e:
            print("caught")
        eff.resume(1)
    return 0
