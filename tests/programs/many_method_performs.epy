# Milestone 5 stress: ten thousand performs fulfilled by a handler
# method. A method returns along the tail-resume path, so dispatch
# switches into the body from its loop, as many_performs.epy does
# with a clause ending in eff.resume(...). The field counts the calls.

from effectpython import Effect, Handler, perform, handle

class Counter(Effect):
    def tick(n: int) -> int: ...

class Modulo(Handler[Counter]):
    calls: int = 0
    def tick(self, n: int) -> int:
        self.calls = self.calls + 1
        return n % 10

def main() -> int / []:
    modulo = Modulo()
    with handle(modulo):
        i = 0
        total = 0
        while i < 10000:
            total = total + perform(Counter.tick(i))
            i = i + 1
        print(total)
    print(modulo.calls)
    return 0
