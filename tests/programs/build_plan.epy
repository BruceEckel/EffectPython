# A third program with a job of its own: a build runs each task
# after the tasks it needs, retries a flaky one up to three times
# with a longer wait each time, and skips a task whose dependency did
# not succeed. Written in Python first and then ported. Until
# Milestone 19 the tasks were four parallel lists and a dict; Task is
# now the data class the Python version has. joined(), padded(), and
# power_of_two() stand in for str.join(), the format spec {name:8},
# and 2 ** n.

from dataclasses import dataclass
from effectpython import Effect, Handler, perform, handle

@dataclass
class Task:
    name: str
    needs: list[str]
    seconds: int
    failures: int = 0

class Clock(Effect):
    def sleep(seconds: int) -> int: ...

class Work(Effect):
    def attempt(task: Task) -> int / [Failed]: ...

class Log(Effect):
    def note(text: str) -> int: ...

class Failed(Exception): ...

class Timer(Handler[Clock]):
    now: int = 0
    def sleep(self, seconds: int) -> int:
        self.now += seconds
        return self.now

class Worker(Handler[Work]):
    tries: dict[str, int] = {}
    def attempt(self, task: Task) -> int / [Clock, Failed]:
        if task.name in self.tries:
            self.tries[task.name] += 1
        else:
            self.tries[task.name] = 1
        now = perform(Clock.sleep(task.seconds))
        if self.tries[task.name] <= task.failures:
            raise Failed(task.name)
        return now

class Report(Handler[Log]):
    lines: list[str] = []
    def note(self, text: str) -> int:
        self.lines.append(text)
        return len(self.lines)

def power_of_two(n: int) -> int:
    result = 1
    for i in range(n):
        result *= 2
    return result

def run(task: Task) -> bool / [Work, Clock, Log]:
    for n in range(1, 4):
        try:
            now = perform(Work.attempt(task))
        except Failed:
            perform(Log.note(f"{task.name}: attempt {n} failed"))
            perform(Clock.sleep(power_of_two(n)))
            continue
        perform(Log.note(f"{task.name}: ok at t={now}"))
        return True
    return False

def joined(words: list[str]) -> str:
    text = ""
    for word in words:
        if text != "":
            text += ", "
        text += word
    return text

def padded(text: str, width: int) -> str:
    while len(text) < width:
        text += " "
    return text

def build(tasks: list[Task]) -> dict[str, str] / [Work, Clock, Log]:
    status = {}
    for task in tasks:
        blocked = []
        for need in task.needs:
            if need not in status or status[need] != "ok":
                blocked.append(need)
        if len(blocked) > 0:
            status[task.name] = "skipped"
            perform(Log.note(
                f"{task.name}: skipped, needs {joined(blocked)}"))
        elif run(task):
            status[task.name] = "ok"
        else:
            status[task.name] = "failed"
    return status

def main() -> int / []:
    tasks = [Task("fetch", [], 3, 1),
             Task("compile", ["fetch"], 10),
             Task("lint", ["fetch"], 2, 5),
             Task("test", ["compile"], 7, 2),
             Task("package", ["test", "lint"], 4),
             Task("docs", [], 1)]
    timer = Timer()
    report = Report()
    with handle(timer, report):
        with handle(Worker()):
            status = build(tasks)
    for line in report.lines:
        print(line)
    counts = {}
    for name in status:
        result = status[name]
        print(padded(name, 8), result)
        if result in counts:
            counts[result] += 1
        else:
            counts[result] = 1
    ordered = {}
    for result in ["failed", "ok", "skipped"]:
        if result in counts:
            ordered[result] = counts[result]
    print(ordered, f"in {timer.now}s")
    return 0
