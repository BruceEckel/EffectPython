# Runtime-only: a list literal whose element has no known type has no
# known type, so nothing refines it and the operator on an element
# passes the checker; the runtime finds the str.

def main() -> int:
    if 1 == 1:
        v = "a"
    else:
        v = 1
    xs = [v]
    xs.append(1)
    print(xs[0] + 1)
    return 0
