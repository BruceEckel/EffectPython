# The clause returns, so the code after the try keeps x as it was,
# but the finally runs first, after exec_clauses deleted the clause's
# name. The checker holds the name unbound while it checks the
# finally, so the runtime's "name is not defined" is unreachable here.

class Boom(Exception):
    pass

def f() -> int:
    x = 1
    try:
        raise Boom("b")
    except Boom as x:
        return 0
    finally:
        print(x + 1)
    return 1

def main() -> int:
    return f()
