# Runtime-only: the exception leaves the suite with x a str, where
# the end of the suite would have left it an int. The checker starts
# the clause from the types at every boundary of the suite, so x is
# unknown there and the operator passes; the runtime finds the str.

class Boom(Exception):
    pass

def main() -> int:
    x = 1
    try:
        x = "s"
        raise Boom("b")
        x = 1
    except Boom:
        print(x + 1)
    return 0
