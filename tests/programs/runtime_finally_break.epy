# Runtime-only: the break leaves the suite with x a str, and the
# finally runs on the way out. The break is a boundary of the suite,
# so the checker holds x unknown in the finally; the runtime finds the
# str.

def main() -> int:
    x = 1
    for i in range(2):
        try:
            x = "s"
            if i == 0:
                break
            x = 1
        finally:
            print(x + 1)
    return 0
