# The runtime's "takes an optional str message" for an argument of
# unknown type (construct_exception) is unreachable: a typed slot
# refuses a value of unknown type (require_known).

class Boom(Exception):
    pass

def main() -> int:
    if 1 == 1:
        msg = 5
    else:
        msg = "five"
    try:
        raise Boom(msg)
    except Boom:
        print("caught")
    return 0
