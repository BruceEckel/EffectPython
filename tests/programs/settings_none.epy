# Milestone 16: None and optional types (plan 1.16). The job of
# settings_layers.epy with a miss handed back as a value: Lookup.get
# returns str | None, a layer that lacks the key performs outward,
# and the outermost clause resumes None. resolve() turns a miss into
# Missing where a setting is required, and address() and main() test
# is None where it is not. first_set() keeps the first value a loop
# finds, the name that starts as None before the loop.

from effectpython import Effect, Handler, perform, handle

class Lookup(Effect):
    def get(key: str) -> str | None: ...
    def source(key: str) -> str | None: ...

class Log(Effect):
    def note(text: str) -> int: ...

class Missing(Exception): ...

class Layer(Handler[Lookup]):
    name: str
    values: dict[str, str]
    hits: int = 0
    def get(self, key: str) -> str | None / [Lookup]:
        if key in self.values:
            self.hits += 1
            return self.values[key]
        return perform(Lookup.get(key))
    def source(self, key: str) -> str | None / [Lookup]:
        if key in self.values:
            return self.name
        return perform(Lookup.source(key))

class Journal(Handler[Log]):
    entries: list[str] = []
    def note(self, text: str) -> int:
        self.entries.append(text)
        return len(self.entries)

def resolve(key: str) -> str / [Lookup, Log, Missing]:
    value = perform(Lookup.get(key))
    source = perform(Lookup.source(key))
    if value is None:
        raise Missing(key)
    if source is None:
        raise Missing(key)
    perform(Log.note(f"{key} = '{value}' ({source})"))
    return value

def address() -> str / [Lookup, Log, Missing]:
    host = resolve("host")
    port = resolve("port")
    prefix = perform(Lookup.get("prefix"))
    if prefix is None:
        return f"{host}:{port}"
    return f"{host}:{port}{prefix}"

def first_set(keys: list[str]) -> str | None / [Lookup]:
    found = None
    for key in keys:
        if found is None:
            found = perform(Lookup.get(key))
    return found

def main() -> int / []:
    env = Layer("env", {"port": "9000", "prefix": ""})
    file = Layer("file", {"host": "db.internal", "user": "app"})
    defaults = Layer("defaults", {"host": "localhost", "port": "8080",
                                  "prefix": "/api"})
    journal = Journal()
    try:
        with handle(Lookup, journal):
            with handle(defaults):
                with handle(file):
                    try:
                        with handle(env):
                            print("web at", address())
                        print("web at", address(), "without env")
                    except Missing as e:
                        print("no address: no setting for", e)
                    with handle(env):
                        for key in ["user", "password"]:
                            try:
                                print(key, "is", resolve(key))
                            except Missing as e:
                                print("no setting for", e)
                        timeout = perform(Lookup.get("timeout"))
                        if timeout is None:
                            print("timeout unset")
                        else:
                            print("timeout", timeout)
                        print(first_set(["login", "user", "host"]),
                              first_set(["login", "token"]))
    except Lookup.get as eff:
        eff.resume(None)
    except Lookup.source as eff:
        eff.resume(None)
    print(env.name, "answered", env.hits)
    print(file.name, "answered", file.hits)
    print(defaults.name, "answered", defaults.hits)
    for entry in journal.entries:
        print(entry)
    return 0
